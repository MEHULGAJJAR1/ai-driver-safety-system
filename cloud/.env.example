# =========================================================================
# cloud/.env.example  -  copy to .env and fill in.  NEVER commit the real .env
# (.gitignore already excludes .env). All values are read from the environment.
# =========================================================================

# --- Runtime ---
ENV=development                 # development | production
HOST=0.0.0.0
PORT=8000

# --- MongoDB Atlas ---
# Leave MONGODB_URI blank to use the in-memory fallback (dev / no-DB demo).
# Atlas format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=driver_safety

# --- Auth ---
# Comma-separated API keys accepted in the "X-API-Key" header.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Force auth on/off. Blank = auto (OFF only when ENV=development AND no keys set).
REQUIRE_AUTH=

# --- CORS ---
# Comma-separated allow-list of origins. Use exact origins in production,
# e.g. https://app.yourdomain.com  (avoid "*" once auth/credentials matter).
CORS_ORIGINS=*

# --- Limits ---
STATE_BUFFER_CAP=5000
